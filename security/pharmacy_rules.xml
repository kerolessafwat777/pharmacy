<odoo>
    <data noupdate="1">

        <!-- 1. قاعدة الصيدلي: رؤية وتعديل الروشتات الخاصة به فقط -->
        <record id="prescription_pharmacist_rule" model="ir.rule">
            <field name="name">Pharmacist: Own Prescriptions Only</field>
            <field name="model_id" ref="model_prescription"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_pharmacist'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2. قاعدة المدير: رؤية جميع الروشتات بدون استثناء -->
        <record id="prescription_manager_rule" model="ir.rule">
            <field name="name">Manager: All Prescriptions</field>
            <field name="model_id" ref="model_prescription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_manager'))]"/>
        </record>

    </data>
</odoo>