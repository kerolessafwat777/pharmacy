
<odoo>
<data >
        <!-- 1. Form View -->
    <record id="product_template_form_view_pharmacy" model="ir.ui.view">
        <field name="name">product.template.form.pharmacy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
               
                <widget name="web_ribbon" title="Low Stock" bg_color="text-bg-danger" invisible="not is_low_stock"/>


        </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="is_medicine"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pharmacy Information"
                      name="pharmacy_info" invisible="not is_medicine">
                    <group>
                        <field name="requires_prescription"/>
                        <field name="min_stock_qty"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
 
    <!-- 2. Custom List View with Red Highlight for Low Stock -->
    <record id="product_template_list_view_pharmacy" model="ir.ui.view">
        <field name="name">product.template.list.pharmacy</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Medicines" decoration-danger="is_low_stock">

                <field name="name" string="Medicine Name"/>
                <field name="categ_id" string="Category"/>
                <field name="qty_available" string="Current Stock"/>
                <field name="min_stock_qty" string="Minimum Stock"/>
                <field name="requires_prescription"/>
                <field name="is_low_stock" column_invisible="1"/>
            </list>
        </field>
    </record>
 
    <!-- 3. Search View -->
    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.search.pharmacy</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="is_low" string="Low Stock" domain="[('is_low_stock', '=', True)]"/>
                <filter name="requires_prescription" string="Requires Prescription" domain="[('requires_prescription', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_category" string="Category" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>
 
    <!-- 4. Window Action (Connected to Views) -->
    <record id="medicine_view_action" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_medicine', '=', True)]</field>
        <field name="context">{'default_is_medicine': True}</field>
        <field name="search_view_id" ref="product_template_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_template_list_view_pharmacy')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product_template_form_view_pharmacy')})]"/>
    </record>
    <record id="ListViewAction" model="ir.actions.client">
        <field name="name">medicine list view</field>
        <field name="tag">Al_Shifa_pharmacy_tag</field>

    </record>

    <menuitem id="medicine_menu_view"
              name="Medicines"
              action="medicine_view_action"
               parent="Al_Shifa_pharmacy_root_menu"
              sequence="1"/>
</data>
  
</odoo>